{
  "$schema": "./rules.schema.json",
  "version": "1.0.0",
  "weights": {
    "technologyExactMatch": 5,
    "capabilityMatch": 4,
    "domainMatch": 3,
    "strongTriggerMatch": 3,
    "weakTriggerMatch": 1,
    "recommendedBonus": 2,
    "requiredDependency": 10,
    "explicitInclusion": 20,
    "explicitExclusion": -50,
    "conflictPenalty": -50
  },
  "layerOrder": [
    "process",
    "domain",
    "implementation",
    "risk",
    "verification"
  ],
  "thresholds": {
    "selectionMinimumScore": 4,
    "highConfidenceThreshold": 8
  },
  "intentRules": {
    "buildNewFeature": {
      "triggers": ["build", "create", "implement", "scaffold", "new feature", "from scratch", "develop"],
      "injectProcess": ["brainstorming", "writing-plans"]
    },
    "debugging": {
      "triggers": ["fix", "bug", "error", "broken", "debug", "crash", "intermittent", "failure", "fails", "failing", "exception", "401", "500", "timeout"],
      "injectProcess": ["systematic-debugging"],
      "suppressProcess": ["brainstorming"]
    },
    "architectureRefactoring": {
      "triggers": ["architecture", "refactor architecture", "modularize", "system design", "domain boundaries"],
      "injectSkills": ["writing-plans"]
    },
    "trivialEdit": {
      "triggers": ["button label", "typo", "color change", "text change", "rename variable", "minor fix"],
      "suppressProcess": ["brainstorming", "writing-plans", "systematic-debugging"]
    }
  },
  "riskBoundaries": {},
  "verificationRules": {
    "frontend": {
      "triggers": ["frontend", "ui", "ux", "browser", "react", "maplibre", "component", "page", "dashboard"],
      "injectVerification": ["verification"]
    },
    "backendApiDb": {
      "triggers": ["api", "database", "postgres", "supabase", "postgis", "backend", "endpoint", "webhook", "rest"],
      "injectVerification": ["verification"]
    },
    "algorithmMath": {
      "triggers": ["algorithm", "function", "utility", "calculation", "statistic", "graph", "formula", "parser"],
      "injectVerification": ["verification"]
    },
    "generalDefault": {
      "injectVerification": ["verification"]
    }
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "rootDir": "router",
    "outDir": "dist/router",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "router/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "third_party",
    "tests",
    "router/build-registry.ts"
  ]
}

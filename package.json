{
  "name": "terraproof",
  "version": "0.4.1",
  "description": "evidence-graded skills, tools, and checks for mapping and remote-sensing AI agents. By Geova.",
  "type": "module",
  "main": "./dist/router/index.js",
  "exports": {
    ".": "./dist/router/index.js",
    "./router": "./dist/router/index.js",
    "./routing": "./routing/registry.json"
  },
  "bin": {
    "terraproof": "bin/terraproof.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "route": "node router/index.ts route",
    "validate": "node router/index.ts validate",
    "registry:build": "node router/build-registry.ts",
    "registry:check": "node router/build-registry.ts --check",
    "test:router": "node tests/router/run.ts",
    "test:validate": "python tests/validate_repo.py",
    "test:package": "node tests/package/smoke.mjs",
    "test": "node tests/router/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esmailhussien/terraproof.git"
  },
  "homepage": "https://github.com/esmailhussien/terraproof#readme",
  "bugs": {
    "url": "https://github.com/esmailhussien/terraproof/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist",
    "routing",
    "skills",
    "instructions",
    "third_party",
    "sources",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "agent",
    "skills",
    "router",
    "geospatial",
    "gis",
    "remote-sensing",
    "earth-observation",
    "mapping"
  ],
  "author": "Terraproof Contributors",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
